# SUSESI Hotel Wi-Fi Helper - Environment Configuration Example
# Copy to .env for local adjustments

# Application Server Settings
HOST=0.0.0.0
PORT=8080
BIND_IP=10.1.11.126
LOG_LEVEL=INFO

# MikroTik HotSpot Endpoints
MIKROTIK_LOGIN_URL=http://10.1.3.1/login
MIKROTIK_PROBE_URL=http://10.1.3.1/login

# Probe Configuration
# Maximum time (in seconds) to wait for MikroTik probe response before declaring failure
PROBE_TIMEOUT_SECONDS=1.5

# Navigation Flow Mode:
# false (Default / Experimental): Displays a branded landing page with a user-initiated
# "İnternete Bağlan" button to test Android Chrome HTTP warning mitigation.
# true: Performs an immediate HTTP 302 redirect to MIKROTIK_LOGIN_URL.
AUTO_REDIRECT=false

# Proxy & Network Settings
# Set to true ONLY if Wi-Fi Helper is placed behind a trusted internal reverse proxy (e.g., NGINX/Traefik).
# When false, client IP is extracted directly from the incoming socket connection.
TRUST_PROXY_HEADERS=false
